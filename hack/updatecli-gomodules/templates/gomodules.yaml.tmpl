# Code generated by hack/updatecli-gomodules; DO NOT EDIT.
name: Update Go modules

pipelineid: dependencies/gomodules

# Publishing is opt-in so local runs continue to update the current checkout.
#{{- if .scm.enabled }}
actions:
  dependency-pr:
    kind: github/pullrequest
    scmid: default
    title: "chore(deps): update Go dependencies"

scms:
  default:
    kind: github
    spec:
      owner: "{{ .scm.owner }}"
      repository: "{{ .scm.repository }}"
      branch: main
      token: '{{ requiredEnv "GITHUB_TOKEN" }}'
      user: External Secrets Operator
      email: ExternalSecretsOperator@users.noreply.github.com
      commitusingapi: true
      workingbranchprefix: dependencies
      workingbranchseparator: "/"
      commitmessage:
        type: chore
        scope: deps
        hidecredit: true
        footers: 'Signed-off-by: External Secrets Operator <ExternalSecretsOperator@users.noreply.github.com>'
#{{- end }}

# Each dependency is resolved once and reused by every go.mod that declares it.
sources:
<%- range .Dependencies %>
  dependency_<% .Index %>:
    name: Get latest <% .Module %> release
    kind: golang/module
    spec:
      age:
        minimum: 168h
      module: '<% .Module %>'
      versionfilter:
        kind: '<% .Kind %>'
<%- if .Pattern %>
        pattern: '<% .Pattern %>'
<%- end %>
<%- end %>

targets:
<%- range $dependency := .Dependencies %>
<%- range $target := $dependency.Targets %>
  dependency_<% $dependency.Index %>_<% $target.Index %>:
    name: Bump <% $dependency.Module %> in <% $target.Path %>
<%- if $target.FileTarget %>
    kind: file
<%- else %>
    kind: golang/gomod
<%- end %>
    sourceid: dependency_<% $dependency.Index %>
#{{- if .scm.enabled }}
    scmid: default
#{{- end }}
    spec:
      file: '<% $target.Path %>'
<%- if $target.FileTarget %>
      matchpattern: '<% $dependency.MatchPattern %>'
      replacepattern: '${1}<% $dependency.Module %> {{ source "dependency_<% $dependency.Index %>" }}${2}'
<%- else %>
      module: '<% $dependency.Module %>'
<%- end %>
<%- end %>
<%- end %>
  tidy-modules:
    name: Tidy all Go modules
    kind: shell
    disablesourceinput: true
    dependsonchange: true
    dependson:
<%- range $dependency := .Dependencies %>
<%- range $target := $dependency.Targets %>
      - dependency_<% $dependency.Index %>_<% $target.Index %>:or
<%- end %>
<%- end %>
#{{- if .scm.enabled }}
    scmid: default
#{{- end }}
    spec:
      shell: /bin/bash
      command: |
        # Native targets render the complete go.mod diff during a preview.
        if [[ "$DRY_RUN" == true ]]; then
          exit 0
        fi

        set -euo pipefail
        modules="$(mktemp)"
        trap 'rm -f "$modules"' EXIT
        {
<%- range .ModuleFiles %>
          printf '%s\n' '<% . %>'
<%- end %>
        } > "$modules"

        jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || printf '4')"
        if ! [[ "$jobs" =~ ^[1-9][0-9]*$ ]]; then
          jobs=4
        elif (( jobs > 8 )); then
          jobs=8
        fi

        # shellcheck disable=SC2016 # The quoted script is evaluated by the inner shell.
        xargs -P "$jobs" -I '{}' /bin/bash -c \
          'dir="${1%/go.mod}"; [[ "$dir" == "$1" ]] && dir=.; GOWORK=off go -C "$dir" mod tidy' _ '{}' < "$modules"
