# Code generated by hack/updatecli-gomodules; DO NOT EDIT.
name: Update Go version

pipelineid: dependencies/golang

# Publishing is opt-in so local runs continue to update the current checkout.
#{{- if .scm.enabled }}
actions:
  dependency-pr:
    kind: github/pullrequest
    scmid: default
    title: "chore(deps): update Go version"

scms:
  default:
    kind: github
    spec:
      owner: "{{ .scm.owner }}"
      repository: "{{ .scm.repository }}"
      branch: main
      token: '{{ requiredEnv "GITHUB_TOKEN" }}'
      user: External Secrets Operator
      email: ExternalSecretsOperator@users.noreply.github.com
      commitusingapi: true
      workingbranchprefix: dependencies
      workingbranchseparator: "/"
      commitmessage:
        type: chore
        scope: deps
        hidecredit: true
        footers: 'Signed-off-by: External Secrets Operator <ExternalSecretsOperator@users.noreply.github.com>'
#{{- end }}

sources:
  go-version:
    name: Get latest Go release
    kind: golang
    spec:
      age:
        minimum: 168h
      versionfilter:
        kind: semver
        pattern: '1.x'

targets:
<%- range $index, $file := .ModuleFiles %>
  go-version_<% $index %>:
    name: Bump Go in <% $file %>
    kind: golang/gomod
    sourceid: go-version
#{{- if $.scm.enabled }}
    scmid: default
#{{- end }}
    spec:
      file: '<% $file %>'
<%- end %>
