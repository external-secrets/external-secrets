# External Secrets CODEOWNERS
#
# Maps repository paths to GitHub teams for review. Syntax reference:
# https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Order matters: the LAST matching pattern wins. The project-wide default
# therefore has to come first, with narrower paths after it.
#
# Teams need explicit write access to the repository, and a team that does not
# exist makes its line a no-op, so keep this file in step with org teams.
#
# The *-reviewers teams deliberately have no write access, so GitHub reports
# them as "Unknown owner" and only the maintainer teams on each line are
# binding code owners.

# --- Project-wide default (must stay first) ---
*                                      @external-secrets/maintainers @external-secrets/interim-maintainers

# --- CI / Infrastructure ---
.github/                               @external-secrets/ci-reviewers @external-secrets/maintainers @external-secrets/interim-maintainers
hack/                                  @external-secrets/ci-reviewers @external-secrets/testing-reviewers @external-secrets/maintainers @external-secrets/interim-maintainers

# --- Testing ---
tests/                                 @external-secrets/testing-reviewers @external-secrets/maintainers @external-secrets/interim-maintainers
e2e/                                   @external-secrets/testing-reviewers @external-secrets/maintainers @external-secrets/interim-maintainers

# --- Documentation ---
docs/                                  @external-secrets/docs-maintainers @external-secrets/maintainers @external-secrets/interim-maintainers

# --- Core Controllers ---
apis/                                  @external-secrets/core-reviewers @external-secrets/maintainers @external-secrets/interim-maintainers
pkg/controllers/                       @external-secrets/core-reviewers @external-secrets/maintainers @external-secrets/interim-maintainers


# --- Providers ---
